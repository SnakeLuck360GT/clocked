# Copy to supabase.env (git-ignored) and fill in from Supabase → Project Settings → API Keys.
# build.sh bakes these into the app so study groups work without pasting anything.
# Only ever the PUBLISHABLE key (sb_publishable_…) or legacy anon key. Never the secret / service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
